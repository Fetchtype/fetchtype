{
  "typography": {
    "heading": {
      "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
      "fontSize": "3.5rem",
      "fontWeight": 700,
      "lineHeight": 1.05,
      "letterSpacing": "-0.03em"
    },
    "subheading": {
      "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
      "fontSize": "2rem",
      "fontWeight": 600,
      "lineHeight": 1.15,
      "letterSpacing": "-0.01em"
    },
    "body": {
      "fontFamily": ["DM Sans", "system-ui", "sans-serif"],
      "fontSize": "1rem",
      "fontWeight": 400,
      "lineHeight": 1.6
    },
    "caption": {
      "fontFamily": ["DM Sans", "system-ui", "sans-serif"],
      "fontSize": "0.875rem",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "button": {
      "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
      "fontSize": "0.9375rem",
      "fontWeight": 600,
      "lineHeight": 1.2,
      "letterSpacing": "0.02em",
      "textTransform": "uppercase"
    },
    "label": {
      "fontFamily": ["Space Mono", "ui-monospace", "monospace"],
      "fontSize": "0.8125rem",
      "fontWeight": 500,
      "lineHeight": 1.3,
      "letterSpacing": "0.08em",
      "textTransform": "uppercase"
    },
    "input": {
      "fontFamily": ["DM Sans", "system-ui", "sans-serif"],
      "fontSize": "1rem",
      "fontWeight": 400,
      "lineHeight": 1.4
    },
    "chart-label": {
      "fontFamily": ["Space Mono", "ui-monospace", "monospace"],
      "fontSize": "0.8125rem",
      "fontWeight": 500,
      "lineHeight": 1.3
    },
    "chart-axis": {
      "fontFamily": ["Space Mono", "ui-monospace", "monospace"],
      "fontSize": "0.75rem",
      "fontWeight": 400,
      "lineHeight": 1.3
    },
    "chart-title": {
      "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
      "fontSize": "1.125rem",
      "fontWeight": 600,
      "lineHeight": 1.2
    },
    "code": {
      "fontFamily": ["Space Mono", "ui-monospace", "monospace"],
      "fontSize": "0.9375rem",
      "fontWeight": 400,
      "lineHeight": 1.5
    },
    "blockquote": {
      "fontFamily": ["DM Sans", "system-ui", "sans-serif"],
      "fontSize": "1.25rem",
      "fontWeight": 400,
      "lineHeight": 1.7,
      "letterSpacing": "-0.01em"
    }
  },
  "color": {
    "light": {
      "text": {
        "primary": { "value": "#0a0a0a" },
        "secondary": { "value": "#404040" },
        "muted": { "value": "#737373" },
        "accent": { "value": "#7c3aed" },
        "inverse": { "value": "#fafafa" }
      },
      "background": {
        "primary": { "value": "#fafafa" },
        "secondary": { "value": "#f5f5f5" },
        "accent": { "value": "#ede9fe" },
        "muted": { "value": "#e5e5e5" }
      },
      "border": {
        "default": { "value": "#d4d4d4" },
        "muted": { "value": "#e5e5e5" },
        "accent": { "value": "#8b5cf6" }
      },
      "interactive": {
        "default": { "value": "#7c3aed" },
        "hover": { "value": "#6d28d9" },
        "active": { "value": "#5b21b6" },
        "focus": { "value": "#7c3aed" },
        "disabled": { "value": "#a3a3a3" }
      }
    },
    "dark": {
      "text": {
        "primary": { "value": "#fafafa" },
        "secondary": { "value": "#d4d4d4" },
        "muted": { "value": "#a3a3a3" },
        "accent": { "value": "#a78bfa" },
        "inverse": { "value": "#0a0a0a" }
      },
      "background": {
        "primary": { "value": "#0a0a0a" },
        "secondary": { "value": "#171717" },
        "accent": { "value": "#2e1065" },
        "muted": { "value": "#262626" }
      },
      "border": {
        "default": { "value": "#404040" },
        "muted": { "value": "#262626" },
        "accent": { "value": "#8b5cf6" }
      },
      "interactive": {
        "default": { "value": "#a78bfa" },
        "hover": { "value": "#c4b5fd" },
        "active": { "value": "#ddd6fe" },
        "focus": { "value": "#a78bfa" },
        "disabled": { "value": "#525252" }
      }
    }
  },
  "spacing": {
    "unit": "0.25rem",
    "scale": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "2xl": "3rem",
      "3xl": "4rem"
    }
  },
  "layout": {
    "maxWidth": {
      "prose": "65ch",
      "content": "72rem",
      "wide": "90rem",
      "full": "100%"
    },
    "breakpoints": {
      "sm": "40rem",
      "md": "48rem",
      "lg": "64rem",
      "xl": "80rem"
    },
    "grid": {
      "columns": 12,
      "gap": "1.5rem"
    }
  },
  "hierarchy": {
    "scale": "major-third",
    "baseSize": "1rem",
    "headings": {
      "h1": {
        "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
        "fontSize": "3.052rem",
        "fontWeight": 700,
        "lineHeight": 1.02,
        "letterSpacing": "-0.03em"
      },
      "h2": {
        "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
        "fontSize": "2.441rem",
        "fontWeight": 700,
        "lineHeight": 1.06,
        "letterSpacing": "-0.02em"
      },
      "h3": {
        "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
        "fontSize": "1.953rem",
        "fontWeight": 650,
        "lineHeight": 1.12
      },
      "h4": {
        "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
        "fontSize": "1.563rem",
        "fontWeight": 600,
        "lineHeight": 1.2
      },
      "h5": {
        "fontFamily": ["Space Grotesk", "system-ui", "sans-serif"],
        "fontSize": "1.25rem",
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "h6": {
        "fontFamily": ["DM Sans", "system-ui", "sans-serif"],
        "fontSize": "1rem",
        "fontWeight": 600,
        "lineHeight": 1.4
      }
    },
    "emphasis": {
      "strong": { "fontWeight": 700 },
      "subtle": { "opacity": 0.7, "fontSize": "0.9375rem" }
    }
  },
  "motion": {
    "duration": {
      "instant": "100ms",
      "fast": "200ms",
      "normal": "300ms",
      "slow": "500ms",
      "glacial": "1000ms"
    },
    "easing": {
      "default": "cubic-bezier(0.4, 0, 0.2, 1)",
      "enter": "cubic-bezier(0, 0, 0.2, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)",
      "bounce": "cubic-bezier(0.34, 1.56, 0.64, 1)",
      "spring": "cubic-bezier(0.22, 1.36, 0.36, 1)"
    },
    "spring": {
      "snappy": { "stiffness": 400, "damping": 30, "mass": 1 },
      "gentle": { "stiffness": 120, "damping": 14, "mass": 1 },
      "bouncy": { "stiffness": 300, "damping": 10, "mass": 1 }
    },
    "preset": {
      "fade-in": {
        "property": "opacity",
        "from": 0,
        "to": 1,
        "duration": "300ms",
        "easing": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "slide-up": {
        "property": "translateY",
        "from": "20px",
        "to": "0",
        "duration": "300ms",
        "easing": "cubic-bezier(0, 0, 0.2, 1)"
      },
      "scale-in": {
        "property": "scale",
        "from": 0.95,
        "to": 1,
        "duration": "200ms",
        "easing": "cubic-bezier(0.22, 1.36, 0.36, 1)"
      }
    },
    "interpolation": {
      "parallax-depth": {
        "input": "scroll",
        "inputRange": [0, 0.5, 1],
        "outputRange": [0, "-50px", "-100px"],
        "easing": "cubic-bezier(0.4, 0, 0.2, 1)"
      },
      "cursor-glow": {
        "input": "mouseDistance",
        "inputRange": [0, "200px"],
        "outputRange": [1, 0]
      }
    }
  },
  "scenes": {
    "camera": {
      "default": {
        "type": "perspective",
        "fov": 45,
        "near": 0.1,
        "far": 1000,
        "position": [0, 2, 5]
      }
    },
    "materials": {
      "brand-surface": {
        "type": "physical",
        "color": "#7c3aed",
        "roughness": 0.35,
        "metalness": 0.1
      },
      "glass": {
        "type": "physical",
        "color": "#ffffff",
        "roughness": 0.05,
        "metalness": 0.0,
        "transmission": 0.95,
        "thickness": 0.5
      }
    },
    "environment": {
      "default": {
        "background": "#0a0a0a"
      }
    }
  }
}
